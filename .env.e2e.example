# 複製為 .env.e2e.local 後填入實際值（.env.e2e.local 不得進版控，Secret 不得寫入 Plan/Results/程式碼）
E2E_BASE_URL=
E2E_ADMIN_USER=
E2E_ADMIN_PASSWORD=
# 修腳本、除錯時的工作停損（E2E-TEST-RULE.md §7）：單一測項最多花幾分鐘、試幾次。給執行的人或 AI 遵守，程式不讀；
# 測項本身的執行時間上限由 Playwright 原生 timeout 控制（e2e/helpers/timeouts.ts）。留空時不得自行猜測，需先向使用者確認
E2E_CASE_STUCK_TIMEOUT_MINUTES=
E2E_CASE_MAX_ATTEMPTS=

# Nx VMS（G3/G4：以 Nx 錄影當辨識來源；只唯讀查詢）
E2E_NX_URL=
E2E_NX_USER=
E2E_NX_PASSWORD=

# 預設 false：完全走真後端。true：真實環境「沒有資料」（清單是空的）時，改用假資料補上，並在報告標示該測項使用了假資料
E2E_IS_MOCK=false
# 預留（尚未實作）：true 時，對假資料的編輯／刪除由假後端處理、不送真後端；預設 false
E2E_MOCK_WRITES=false
