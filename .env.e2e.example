# 複製為 .env.e2e.local 後填入實際值（.env.e2e.local 不得進版控，Secret 不得寫入 Plan/Results/程式碼）
E2E_BASE_URL=
E2E_ADMIN_USER=
E2E_ADMIN_PASSWORD=
# 以下兩項依 Rule §7 必須由使用者設定；留空時不得自行猜測，需先向使用者確認
E2E_CASE_STUCK_TIMEOUT_MINUTES=
E2E_CASE_MAX_ATTEMPTS=

# Nx VMS（G3/G4：以 Nx 錄影當辨識來源；只唯讀查詢）
E2E_NX_URL=
E2E_NX_USER=
E2E_NX_PASSWORD=
